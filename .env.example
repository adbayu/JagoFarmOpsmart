# Local Docker PostgreSQL defaults. Change these together if you customize them.
POSTGRES_DB=opsmart
POSTGRES_USER=opsmart
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://opsmart:local-development-only@127.0.0.1:5432/opsmart
# Production migrations use a dedicated DDL login; grant it database ownership or CREATE on public.
# MIGRATION_DATABASE_URL=postgres://opsmart_migrator:local-development-only@127.0.0.1:5432/opsmart
PORT=3001
# Browser origin. In production, use the public HTTPS origin and terminate TLS at a trusted proxy.
APP_ORIGIN=http://127.0.0.1:5173
# Optional Kolab standup delivery; keep disabled until Chromium and the encryption key are configured.
KOLAB_SYNC_ENABLED=false
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
KOLAB_SESSION_ENCRYPTION_KEY=
# Required only for optional concurrency tests; use a dedicated disposable DB.
# TEST_DATABASE_URL=postgres://opsmart:local-development-only@127.0.0.1:5432/opsmart_test
