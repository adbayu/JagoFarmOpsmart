{
  "name": "jagofarm-opsmart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:server:preview": "tsx --env-file-if-exists=.env src/server/local-preview-main.ts",
    "build": "npm run typecheck && vite build --configLoader runner && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test:postgres": "tsx --env-file-if-exists=.env --test tests/postgres/*.test.ts",
    "format": "prettier --write src tests scripts docs *.json *.md",
    "format:check": "prettier --check src tests scripts docs *.json *.md",
    "start": "node --env-file-if-exists=.env dist/server/server/main.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
